# ── MODUS ─────────────────────────────────────────────────────────────────────
# 'cli' = Claude Code CLI (kein API Key nötig, Claude Code muss installiert sein)
# 'api' = Anthropic API   (ANTHROPIC_API_KEY erforderlich)
CLAUDE_MODE=cli

# ── API (nur für CLAUDE_MODE=api) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3000

# ── AUTONOMER BETRIEB ─────────────────────────────────────────────────────────
CYCLE_INTERVAL_MINUTES=60
MAX_AGENT_CALLS_PER_CYCLE=20

# ── TOKEN-BUDGET (nur für CLAUDE_MODE=api) ────────────────────────────────────
DAILY_TOKEN_LIMIT=100000

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Meta-Evaluation nach jeder Deliberation (true/false)
META_EVALUATION=true

# Maximale Runden im iterativen Loop (default: 3)
MAX_LOOP_ROUNDS=3

# ── TELEGRAM NOTIFICATIONS ────────────────────────────────────────────────────
# Push-Benachrichtigungen bei kritischen Events (Eskalation, Metrik, Webhook)
# Leer lassen wenn keine Notifications gewünscht
# Setup: 1) @BotFather → /newbot → Token kopieren
#         2) @userinfobot → deine Chat-ID kopieren
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ASSISTENT (Chat: Dashboard-Tab "Assistent" + Telegram) ────────────────────
# Lokales Modell (Bonsai über llama-server, siehe scripts/install-bonsai-pi.sh)
LOCAL_LLM_URL=http://127.0.0.1:8080
LOCAL_LLM_MAX_TOKENS=700
LOCAL_LLM_TIMEOUT_MS=240000
# Wie viel Vault-Text pro Frage ans Modell geht (weniger = schneller am Pi)
ASSISTANT_CONTEXT_CHARS=6000

# Obsidian-Vault (auf dem Pi via obsidian-headless, siehe deploy/obsidian-sync.service)
VAULT_PATH=/home/admin/vault
# Name des Vaults in der Obsidian-App (für obsidian://-Links)
VAULT_NAME=Vault
# Vault-Index alle N Minuten aktualisieren (voller Neuaufbau täglich 03:00)
VAULT_INDEX_MINUTES=10

# Telegram-Chat mit dem Assistenten nutzt TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (oben).
# Der Bot antwortet ausschliesslich dieser Chat-ID.

# Todoist (Einstellungen → Integrationen → Entwickler → API-Token)
TODOIST_API_TOKEN=
# Optional: Projekt für neue Aufgaben (leer = Eingang)
TODOIST_PROJECT_ID=

# Webhook-URLs in `node run.js --webhooks` (Default: http://localhost:PORT)
WEBHOOK_HOST=
